{
  "name": "pi-claude-plan",
  "version": "1.8.2",
  "type": "module",
  "description": "Unofficial Pi provider for attempting Claude Pro/Max plan routing without replacing Pi's built-in Anthropic provider.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunipan/pi-claude-plan.git"
  },
  "homepage": "https://github.com/sunipan/pi-claude-plan#readme",
  "bugs": {
    "url": "https://github.com/sunipan/pi-claude-plan/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "anthropic",
    "claude",
    "oauth"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "upstream": {
    "name": "@ex-machina/opencode-anthropic-auth",
    "version": "1.8.1",
    "url": "https://github.com/ex-machina-co/opencode-anthropic-auth"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
